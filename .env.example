# Replace with a unique random value of at least 32 characters.
SECRET_KEY=replace-this-with-a-random-secret
ENVIRONMENT=development
DATABASE_URL=sqlite:///./app.db
UPLOAD_DIR=app/uploads
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_BYTES=4194304

# Comma-separated public hostnames/origins when deploying behind HTTPS.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
